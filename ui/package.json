    "test:e2e": "playwright test",
    "type-check": "vue-tsc --build --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "clean": "rimraf dist/*"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
